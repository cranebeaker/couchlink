// Version information for a Couchlink hook DLL. Filled in by CMake (configure_file).
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,3,0
 PRODUCTVERSION 0,1,3,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Co-op Anything\0"
            VALUE "FileDescription", "@CL_FILE_DESCRIPTION@\0"
            VALUE "FileVersion", "0.1.3\0"
            VALUE "InternalName", "@CL_INTERNAL_NAME@\0"
            VALUE "LegalCopyright", "MIT License. Copyright (C) 2026 Co-op Anything.\0"
            VALUE "OriginalFilename", "@CL_ORIGINAL_NAME@\0"
            VALUE "ProductName", "Couchlink\0"
            VALUE "ProductVersion", "0.1.3\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
